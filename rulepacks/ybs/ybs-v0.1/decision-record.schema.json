{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YBS deterministic decision record",
  "type": "object",
  "required": ["evaluator", "rule_pack", "evaluation_date", "final_classification", "rule_results", "facts_used", "missing_facts", "decision_id"],
  "properties": {
    "final_classification": {"enum": ["Young", "Beginning", "Small", "Young + Beginning", "Young + Small", "Beginning + Small", "Young + Beginning + Small", "Not Eligible", "Unable To Determine", "Review Required"]},
    "decision_id": {"type": "string"},
    "rule_results": {"type": "array"},
    "facts_used": {"type": "array"},
    "missing_facts": {"type": "array"},
    "subject_results": {"type": "array"}
  }
}

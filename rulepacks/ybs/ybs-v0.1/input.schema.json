{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical YBS case",
  "type": "object",
  "required": ["evaluation_date", "subjects"],
  "properties": {
    "case_id": {"type": "string"},
    "evaluation_date": {"type": "string", "format": "date"},
    "reporting_period": {"type": "string"},
    "rule_pack_id": {"type": "string"},
    "determination_subject_ids": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["id", "type"], "properties": {"id": {"type": "string"}, "type": {"type": "string"}}}},
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["person", "entity"]},
          "is_agricultural_producer": {"type": "boolean"},
          "date_of_birth": {"type": "string", "format": "date"},
          "years_farming": {"type": "number", "minimum": 0},
          "annual_gross_ag_sales": {"type": "number", "minimum": 0},
          "conflicting_fields": {"type": "array", "items": {"type": "string"}},
          "attribution_conflict": {"type": "boolean"},
          "attribution": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["subject_id", "role"],
              "properties": {
                "subject_id": {"type": "string"},
                "role": {"enum": ["owner", "managing_member", "general_partner", "trustee", "operator", "controlling_person"]},
                "ownership_percentage": {"type": "number", "minimum": 0, "maximum": 100}
              }
            }
          }
        }
      }
    }
  }
}
